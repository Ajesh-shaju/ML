      "source": [
        "import numpy as np\n",
        "from sklearn.datasets import fetch_20newsgroups\n",
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.metrics import accuracy_score\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "categories = ['alt.atheism', 'soc.religion.christian', 'comp.graphics', 'sci.med']\n",
        "print(\"Loading 20 Newsgroups dataset...\")\n",
        "train_data = fetch_20newsgroups(subset='train', categories=categories, remove=('headers', 'footers', 'quotes'))\n",
        "test_data = fetch_20newsgroups(subset='test', categories=categories, remove=('headers', 'footers', 'quotes'))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "_ChMZx5vINT1",
        "outputId": "4108103c-7a13-44bf-ba5a-8bb8e9f84671"
      },
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loading 20 Newsgroups dataset...\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "vectorizer = CountVectorizer(stop_words='english', max_features=5000)\n",
        "X_train = vectorizer.fit_transform(train_data.data).toarray()\n",
        "y_train = train_data.target\n",
        "X_test = vectorizer.transform(test_data.data).toarray()\n",
        "y_test = test_data.target"
      ],
      "metadata": {
        "id": "fywHxNLaISfe"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "n_classes = len(categories)\n",
        "n_features = X_train.shape[1]\n",
        "print(f\"Train shape: {X_train.shape}, Test shape: {X_test.shape}\")\n",
        "# Calculate class priors P(c)\n",
        "class_counts = np.bincount(y_train)\n",
        "p_labels = class_counts / len(y_train)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eJQp2tfBIYBd",
        "outputId": "28d6d3a6-374c-4c7d-df81-2cddb59c2b17"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Train shape: (2257, 5000), Test shape: (1502, 5000)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "N_c = np.zeros((n_classes, n_features))\n",
        "for c in range(n_classes):\n",
        "    N_c[c, :] = X_train[y_train == c].sum(axis=0)\n",
        "print(\"Word counts aggregated successfully.\")\n",
        "\n",
        "def predict_naive_bayes(X, theta, p_labels):\n",
        "    \"\"\"\n",
        "    Predicts classes using log-probabilities to avoid underflow.\n",
        "    Log-likelihood: X . log(Theta^T) + log(P(c))\n",
        "    \"\"\"\n",
        "    with np.errstate(divide='ignore'):\n",
        "        log_theta = np.log(theta)\n",
        "        log_theta[np.isinf(log_theta)] = -1e9\n",
        "        log_posterior = X @ log_theta.T + np.log(p_labels)\n",
        "    return np.argmax(log_posterior, axis=1)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "eUPRB6XAIbTF",
        "outputId": "7cf33203-2b25-437b-b0d0-2729500e9354"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Word counts aggregated successfully.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "theta_mle = N_c / N_c.sum(axis=1, keepdims=True)\n",
        "\n",
        "y_pred_mle = predict_naive_bayes(X_test, theta_mle, p_labels)\n",
        "mle_accuracy = accuracy_score(y_test, y_pred_mle)\n",
        "print(f\"[MLE] Test Accuracy: {mle_accuracy:.4f}\")\n",
        "\n",
        "priors_to_test = {\n",
        "    \"Lidstone Smoothing (Alpha = 1.01)\": np.ones(n_features) * 1.01,\n",
        "    \"Laplace Smoothing (Alpha = 2.0)\": np.ones(n_features) * 2.0,\n",
        "    \"Strong Dirichlet Prior (Alpha = 10.0)\": np.ones(n_features) * 10.0,\n",
        "    \"Non-Uniform Prior (Empirical Basis)\": 1.0 + (X_train.sum(axis=0) / X_train.sum() * 100)\n",
        "}\n",
        "\n",
        "print(\"Evaluating MAP Predictions:\")\n",
        "print(\"-\" * 55)\n",
        "for name, alpha in priors_to_test.items():\n",
        "    numerator = N_c + (alpha - 1)\n",
        "    denominator = numerator.sum(axis=1, keepdims=True)\n",
        "    theta_map = numerator / denominator\n",
        "\n",
        "    y_pred_map = predict_naive_bayes(X_test, theta_map, p_labels)\n",
        "    map_accuracy = accuracy_score(y_test, y_pred_map)\n",
        "    print(f\"{name:38} | Test Accuracy: {map_accuracy:.4f}\")"
      ],
